# Exemplo documental: mantenha valores vazios e nunca adicione credenciais reais.
# Todos os modelos executam localmente ou em infraestrutura da instituição; nunca usar nuvem pública.

# Servidor vLLM local que serve o Qwen3.5-4B com o adaptador LoRA
VLLM_BASE_URL=
VLM_MODELO_BASE=
VLM_ADAPTADOR_LORA=

# Transcrição (PaddleOCR-VL) e detector de injeção, por caminho local ou endpoint local
TRANSCRICAO_MODELO=
DETECTOR_INJECAO_MODELO=

# Diretórios de entrada, saída e configuração versionada do pipeline
DIRETORIO_ENTRADA=
DIRETORIO_SAIDA=
CONFIG_PIPELINE=  # caminho para config/pipeline.yaml

APP_ENV=
LOG_LEVEL=
